---
import BaseLayout from '../layouts/BaseLayout.astro';
import PathCard from '../components/PathCard.astro';
// import { Icon } from 'astro-icon/components'; // re-enable when highlights grid is uncommented

// ─────────────────────────────────────────────
// EDIT ME — all page copy lives here
// ─────────────────────────────────────────────
const content = {
  // <head> meta
  seoTitle: 'Home',
  seoDescription: 'Mike Fortman — full stack engineer building fast, accessible web UIs.',

  // Hero
  subtitle:  '// full stack engineer · dallas, tx',
  name:      'Mike Fortman',
  bio: [
    '🧀 in Texas. Husband, Dad, and Full Stack engineer with a passion for frontend.',
    'Fueled by a deep understanding of the customer and product, meaningful user reach, and precision and performance.',
    'Currently building OpenRAG at IBM',
  ],

  // Education card
  school:    'University of Wisconsin-Madison',
  schoolSub: 'Madison, WI',
  degrees:   ['B.S. Computer Science', 'B.S. Computer Engineering'],

  // Stack card (icon names come from simple-icons / astro-icon)
  stack: [
    { name: 'React',      icon: 'simple-icons:react' },
    { name: 'TypeScript', icon: 'simple-icons:typescript' },
    { name: 'Next.js',    icon: 'simple-icons:nextdotjs' },
    { name: 'Python',     icon: 'simple-icons:python' },
    { name: 'Tailwind',   icon: 'simple-icons:tailwindcss' },
    { name: 'GraphQL',    icon: 'simple-icons:graphql' },
    { name: 'Docker',     icon: 'simple-icons:docker' },
    { name: 'Astro',      icon: 'simple-icons:astro' },
  ],

  // Currently card
  currently: [
    'Building in AI/open-source',
    'Developer tools and DX',
    'Dad to Eloise (Weezy)',
    'Ranking NBA players',
  ],

  // Values card
  values: [
    'Ship fast iterate faster',
    'Accessibility matters',
    'Open source > closed',
    'Best code = deleted code',
  ],

  // Work path card
  work: {
    title: 'Professional Journey',
    desc:  'School, IBM, and everything stop in between.',
    // tags:  ['Frontend', 'AI/ML', 'Design Systems'],
  },

  // Fun path card
  fun: {
    title: 'Off the Clock',
    desc:  'My NBA Mount Rushmore, Favorite Pokemon, etc the real way to get to know me.',
    // tags:  ['Sports', 'Games', 'Open Source'],
  },
};
// ─────────────────────────────────────────────
---

<BaseLayout title={content.seoTitle} description={content.seoDescription}>
  {/* ── Hero ── */}
  <section class="hero-section">
    <div class="hero-grid-bg" aria-hidden="true"></div>
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-inner max-w-4xl">
      <img src="/fam.jpg" alt={content.name} class="hero-photo" />
      <div class="hero-bio">
        <p class="hero-subtitle">{content.subtitle}</p>
        <h1 class="hero-name">{content.name}</h1>
        <div class="hero-body">
          {content.bio.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </section>

  {/* ── Highlights Grid — commented out ── */}
  {/* <section class="highlights-section">
    <div class="highlights-inner">

      <div class="highlights-row">
        <div class="card card-cyan">
          <p class="card-label label-cyan">// education</p>
          <div class="edu-header">
            <div class="edu-logo-wrap">
              <span class="edu-logo-icon" aria-hidden="true"><Icon name="wisconsin" /></span>
            </div>
            <div>
              <p class="edu-school">{content.school}</p>
              <p class="edu-sub">{content.schoolSub}</p>
            </div>
          </div>
          <p class="edu-degrees">
            {content.degrees.map((d, i) => <>{d}{i < content.degrees.length - 1 && <br />}</>)}
          </p>
        </div>

        <div class="card card-cyan">
          <p class="card-label label-cyan">// stack</p>
          <div class="tags">
            {content.stack.map((t) => (
              <span class="tag tag-cyan">
                <span class="tag-icon" aria-hidden="true"><Icon name={t.icon} /></span>
                {t.name}
              </span>
            ))}
          </div>
        </div>
      </div>

      <div class="highlights-row">
        <div class="card card-purple">
          <p class="card-label label-purple">// currently</p>
          <ul class="bullet-list">
            {content.currently.map((item) => (
              <li><span class="bullet-purple">▸</span> {item}</li>
            ))}
          </ul>
        </div>

        <div class="card card-purple">
          <p class="card-label label-purple">// values</p>
          <ul class="bullet-list">
            {content.values.map((item) => (
              <li><span class="bullet-purple">▸</span> {item}</li>
            ))}
          </ul>
        </div>
      </div>

    </div>
  </section> */}

  {/* ── Two Paths ── */}
  <section class="paths-section">
    <div class="paths-inner max-w-4xl">
      <PathCard
        href="/experience"
        title={content.work.title}
        desc={content.work.desc}
        cta="cd ~/work →"
        accent="cyan"
      />
      <PathCard
        href="/fun"
        title={content.fun.title}
        desc={content.fun.desc}
        cta="cd ~/fun →"
        accent="purple"
      />
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero-section {
    position: relative;
    padding: 72px 48px 64px;
    overflow: hidden;
  }
  .hero-grid-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(var(--accent-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--accent-grid) 1px, transparent 1px);
    background-size: 48px 48px;
    z-index: 0;
  }
  .hero-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(ellipse at top, var(--accent-glow), transparent);
    pointer-events: none;
    z-index: 0;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    margin: 0 auto;
    display: flex;
    gap: 48px;
    align-items: flex-start;
  }
  .hero-photo {
    width: 240px;
    height: 300px;
    border-radius: 16px;
    border: 2px solid var(--border-cyan);
    box-shadow: 0 0 40px var(--accent-bg);
    object-fit: cover;
    object-position: 72% 15%;
    flex-shrink: 0;
  }
  .hero-bio {
    flex: 1;
  }
  .hero-subtitle {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    font-weight: 400;
    color: var(--accent);
    letter-spacing: 0.04em;
    margin: 0 0 12px;
  }
  .hero-name {
    font-family: 'JetBrains Mono', monospace;
    font-size: 48px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.04em;
    line-height: 1;
    margin: 0 0 20px;
  }
  .hero-body {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .hero-body p {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 15px;
    font-weight: 400;
    color: var(--text-body);
    line-height: 1.7;
    margin: 0;
  }

  /* ── Highlights Grid ── */
  .highlights-section {
    padding: 48px 48px 56px;
  }
  .highlights-inner {
    max-width: 56rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .highlights-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  /* ── Cards ── */
  .card {
    padding: 22px;
    background: var(--surface);
    border-radius: 12px;
  }
  .card-cyan  { border: 1px solid var(--accent-border); }
  .card-purple { border: 1px solid var(--accent-2-border); }

  .card-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    margin: 0 0 10px;
  }
  .label-cyan   { color: var(--accent); }
  .label-purple { color: var(--accent-2); }

  /* Education */
  .edu-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }
  .edu-logo-wrap {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .edu-logo-icon {
    display: inline-flex;
    width: 24px;
    height: 24px;
  }
  .edu-logo-icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .edu-school {
    font-size: 14px;
    font-weight: 700;
    color: var(--text-card);
    margin: 0;
  }
  .edu-sub {
    font-size: 11px;
    color: var(--text-muted);
    margin: 0;
  }
  .edu-degrees {
    font-size: 12px;
    color: var(--text-body);
    line-height: 1.5;
    margin: 0;
  }

  /* Tags */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    padding: 4px 8px;
    border-radius: 5px;
  }
  .tag-cyan   { background: var(--accent-glow); border: 1px solid var(--accent-border); color: var(--accent); }
  .tag-purple { background: var(--accent-2-bg); border: 1px solid var(--accent-2-border); color: var(--accent-2); }
  .tag-icon {
    display: inline-flex;
    width: 11px;
    height: 11px;
    flex-shrink: 0;
  }
  .tag-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  /* Bullet lists */
  .bullet-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .bullet-list li {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 12px;
    color: var(--text-body);
    line-height: 1.7;
  }
  .bullet-purple { color: var(--accent-2); }

  /* ── Two Paths ── */
  .paths-section {
    padding: 0 48px 64px;
  }
  .paths-inner {
    margin: 0 auto;
    display: flex;
    gap: 16px;
  }
  /* ── Mobile breakpoints ── */
  @media (max-width: 640px) {
    .hero-section  { padding: 48px 20px 0; }
    .hero-inner    { flex-direction: column; align-items: center; gap: 24px; }
    .hero-photo    { width: 200px; height: 250px; }
    .hero-name     { font-size: 32px; }

    .highlights-section { padding: 32px 20px 40px; }
    .highlights-row     { grid-template-columns: 1fr; }

    .paths-section { padding: 0 20px 48px; }
    .paths-inner   { flex-direction: column; }
  }
</style>
