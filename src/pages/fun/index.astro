---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PathCard from '../../components/PathCard.astro';
---

<BaseLayout title="Fun" description="Off-the-clock projects: Pokémon squad, NBA top 10.">
  <section class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="font-display text-4xl font-semibold tracking-tight sm:text-5xl">Off the clock</h1>
    <p class="mt-3 max-w-xl text-text-muted">
      Personality stuff. Defended opinions only.
    </p>

    <div class="paths-inner mt-10">
      <PathCard
        href="/fun/pokemon"
        title="Ultimate Pokémon squad"
        desc="The team I'd actually take into a fight. With reasoning."
        cta="Six picks →"
        accent="cyan"
      />
      <PathCard
        href="/fun/nba"
        title="NBA top 25"
        desc="My ranking vs. consensus. GOAT debate, settled (for me, anyway)."
        cta="25 ranks →"
        accent="purple"
      />
    </div>
  </section>
</BaseLayout>

<style>
  .paths-inner {
    display: flex;
    gap: 16px;
  }

  @media (max-width: 640px) {
    .paths-inner {
      flex-direction: column;
    }
  }
</style>
