---
const links = [
  { href: '/',        label: 'Home',    section: 'pro' },
  { href: '/work',    label: 'Work',    section: 'pro' },
  { href: '/about',   label: 'About',   section: 'pro' },
  { href: '/fun',     label: 'Fun',     section: 'fun' },
  { href: '/contact', label: 'Contact', section: 'pro' },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
---

<header
  class="sticky top-0 z-50"
  style="background: rgba(10,10,15,0.85); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(255,255,255,0.06);"
>
  <nav
    class="mx-auto flex items-center justify-between max-w-5xl"
    style="padding: 14px 48px;"
    aria-label="Primary"
  >
    {/* Logo: mf_ */}
    <a href="/" class="font-mono text-base font-bold leading-none" style="text-decoration: none;">
      <span style="color: #22d3ee;">mf</span><span style="color: #555;">_</span>
    </a>

    {/* Desktop links */}
    <ul class="hidden items-center md:flex" style="gap: 28px; list-style: none; margin: 0; padding: 0;">
      {
        links.slice(1).map((l) => {
          const active = isActive(l.href);
          const activeColor = l.section === 'fun' ? '#a855f7' : '#22d3ee';
          return (
            <li>
              <a
                href={l.href}
                aria-current={active ? 'page' : undefined}
                style={`font-family: system-ui, -apple-system, sans-serif; font-size: 13px; font-weight: 500; text-decoration: none; transition: color 120ms; color: ${active ? activeColor : '#6b7280'};`}
                onmouseover={`this.style.color='${active ? activeColor : '#9ca3af'}'`}
                onmouseout={`this.style.color='${active ? activeColor : '#6b7280'}'`}
              >
                {l.label}
              </a>
            </li>
          );
        })
      }
    </ul>

    {/* Mobile hamburger */}
    <button
      type="button"
      id="nav-toggle"
      class="inline-flex items-center justify-center md:hidden"
      style="width: 20px; height: 20px; background: none; border: none; cursor: pointer; padding: 0;"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 20 20"
        fill="#6b7280"
        width="20"
        height="20"
        aria-hidden="true"
        id="hamburger-icon"
      >
        <rect y="3" width="20" height="2" rx="1"/>
        <rect y="9" width="20" height="2" rx="1"/>
        <rect y="15" width="20" height="2" rx="1"/>
      </svg>
    </button>
  </nav>

  {/* Mobile menu */}
  <div id="mobile-menu" hidden style="border-top: 1px solid rgba(255,255,255,0.06);">
    <ul
      class="mx-auto flex max-w-5xl flex-col"
      style="gap: 4px; padding: 12px 20px; list-style: none; margin: 0;"
    >
      {
        links.slice(1).map((l) => {
          const active = isActive(l.href);
          const activeColor = l.section === 'fun' ? '#a855f7' : '#22d3ee';
          return (
            <li>
              <a
                href={l.href}
                aria-current={active ? 'page' : undefined}
                style={`display: block; padding: 8px 12px; font-size: 13px; font-weight: 500; text-decoration: none; border-radius: 6px; color: ${active ? activeColor : '#6b7280'};`}
              >
                {l.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</header>

<script>
  function bindNav() {
    const btn = document.getElementById('nav-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu || btn.dataset.bound === 'true') return;
    btn.dataset.bound = 'true';

    btn.addEventListener('click', () => {
      const open = menu.hasAttribute('hidden');
      if (open) {
        menu.removeAttribute('hidden');
      } else {
        menu.setAttribute('hidden', '');
      }
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
  }

  bindNav();
  document.addEventListener('astro:after-swap', bindNav);
</script>
