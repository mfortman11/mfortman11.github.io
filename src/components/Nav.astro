---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/',            label: 'Home',    section: 'pro' },
  { href: '/experience',  label: 'Work',    section: 'pro' },
  { href: '/fun',         label: 'Fun',     section: 'fun' },
  { href: '/contact',     label: 'Contact', section: 'pro' },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
---

<header
  class="sticky top-0 z-50"
  style="background: var(--nav-bg); backdrop-filter: blur(12px); border-bottom: 1px solid var(--border);"
>
  <nav
    class="mx-auto flex items-center justify-between max-w-5xl"
    style="padding: 14px 48px;"
    aria-label="Primary"
  >
    {/* Logo: mf_ */}
    <a href="/" class="font-mono text-base font-bold leading-none" style="text-decoration: none;">
      <span style="color: var(--accent);">mf</span><span style="color: var(--text-muted);">_</span>
    </a>

    {/* Desktop links */}
    <ul class="hidden items-center md:flex" style="gap: 28px; list-style: none; margin: 0; padding: 0;">
      {
        links.map((l) => {
          const active = isActive(l.href);
          return (
            <li>
              <a
                href={l.href}
                aria-current={active ? 'page' : undefined}
                class={`nav-link ${l.section === 'fun' ? 'nav-link-fun' : ''} ${active ? 'nav-link-active' : ''}`}
              >
                {l.label}
              </a>
            </li>
          );
        })
      }
    </ul>

    <div class="hidden items-center md:flex" style="gap: 4px;">
      <ThemeToggle />
    </div>

    {/* Mobile controls */}
    <div class="flex items-center md:hidden" style="gap: 8px;">
      <ThemeToggle />
      <button
        type="button"
        id="nav-toggle"
        class="inline-flex items-center justify-center"
        style="width: 20px; height: 20px; background: none; border: none; cursor: pointer; padding: 0;"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
          style="color: var(--text-muted);"
          width="20"
          height="20"
          aria-hidden="true"
          id="hamburger-icon"
        >
          <rect y="3" width="20" height="2" rx="1"/>
          <rect y="9" width="20" height="2" rx="1"/>
          <rect y="15" width="20" height="2" rx="1"/>
        </svg>
      </button>
    </div>
  </nav>

  {/* Mobile menu */}
  <div id="mobile-menu" hidden style="border-top: 1px solid var(--border);">
    <ul
      class="mx-auto flex max-w-5xl flex-col"
      style="gap: 4px; padding: 12px 20px; list-style: none; margin: 0;"
    >
      {
        links.map((l) => {
          const active = isActive(l.href);
          return (
            <li>
              <a
                href={l.href}
                aria-current={active ? 'page' : undefined}
                class={`nav-link nav-link-mobile ${l.section === 'fun' ? 'nav-link-fun' : ''} ${active ? 'nav-link-active' : ''}`}
              >
                {l.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</header>

<style>
  .nav-link {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition: color 120ms;
    color: var(--text-muted);
  }
  .nav-link:hover {
    color: var(--text-body);
  }
  .nav-link-active {
    color: var(--accent);
  }
  .nav-link-active:hover {
    color: var(--accent);
  }
  .nav-link-fun.nav-link-active {
    color: var(--accent-2);
  }
  .nav-link-fun.nav-link-active:hover {
    color: var(--accent-2);
  }
  .nav-link-mobile {
    display: block;
    padding: 8px 12px;
    border-radius: 6px;
  }
</style>

<script>
  function bindNav() {
    const btn = document.getElementById('nav-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu || btn.dataset.bound === 'true') return;
    btn.dataset.bound = 'true';

    btn.addEventListener('click', () => {
      const open = menu.hasAttribute('hidden');
      if (open) {
        menu.removeAttribute('hidden');
      } else {
        menu.setAttribute('hidden', '');
      }
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
  }

  bindNav();
  document.addEventListener('astro:after-swap', bindNav);
</script>
